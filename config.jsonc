{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "white",
      "2": "white"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "board",
      "key": " PC",
      "format": "{vendor} {name}",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "white"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "white"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "white"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "white"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "white"
    },
    {
      "type": "swap",
      "key": "└ └󰓡",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "white"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "white"
    },
    {
      "type": "de",
      "key": "│ ├",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "white"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "white"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "white"
    },
    {
      "type": "theme",
      "key": "│ ├󰸌",
      "keyColor": "white",
      "format": "{theme1} {#90}●{#37}●{#36}●{#35}●{#34}●{#33}●{#32}●{#31}●{#}"
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "white",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "white"
    },
    {
      "type": "command",
      "key": "󰚰 Last Update",
      "keyColor": "white",
      "text": "ts=$(grep -E '\\[PACMAN\\] starting full system upgrade|\\[ALPM\\] upgraded ' /var/log/pacman.log 2>/dev/null | tail -n 1 | sed -E 's/^\\[([^]]+)\\].*/\\1/'); [ -n \"$ts\" ] && date -d \"$ts\" +'%d %b %Y, %H:%M' || echo 'Never'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}

